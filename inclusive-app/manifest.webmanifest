{
  "name": "Inclusive Design System — ATS",
  "short_name": "Inclusive ATS",
  "description": "Accessible applicant tracking demo built on the Inclusive Design System. WCAG 2.2 AA conformant, engineered towards AAA.",
  "start_url": "/dashboard",
  "scope": "/",
  "id": "/dashboard",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "theme_color": "#030304",
  "background_color": "#030304",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity"
  ],
  "icons": [
    {
      "src": "/inclusive-app/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/inclusive-app/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/inclusive-app/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/inclusive-app/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "icons": [
        {
          "src": "/inclusive-app/icons/shortcut-dashboard.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/inclusive-app/icons/shortcut-dashboard-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Candidates",
      "short_name": "Candidates",
      "url": "/candidates",
      "icons": [
        {
          "src": "/inclusive-app/icons/shortcut-candidates.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/inclusive-app/icons/shortcut-candidates-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Today's Interviews",
      "short_name": "Interviews",
      "url": "/interviews",
      "icons": [
        {
          "src": "/inclusive-app/icons/shortcut-interviews.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/inclusive-app/icons/shortcut-interviews-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search Candidates",
      "short_name": "Search",
      "url": "/candidates?search=true",
      "icons": [
        {
          "src": "/inclusive-app/icons/shortcut-search.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/inclusive-app/icons/shortcut-search-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "resume",
          "accept": [
            "application/pdf",
            ".pdf",
            ".doc",
            ".docx"
          ]
        }
      ]
    }
  },
  "related_applications": [],
  "prefer_related_applications": false,
  "screenshots": [
    {
      "src": "/inclusive-app/screenshots/dashboard-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "ATS dashboard with pipeline KPIs"
    },
    {
      "src": "/inclusive-app/screenshots/dashboard-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Candidates list on mobile"
    }
  ]
}
